# Copy to terraform.tfvars (git-ignored). Every value below is the default.
aws_region         = "ap-southeast-2"
project            = "tictactoe"
environment        = "prod"
vpc_cidr           = "10.0.0.0/24"
app_port           = 80
instance_type      = "t3.small"
root_volume_size   = 20
compose_version    = "v2.29.7"
ecr_images_to_keep = 10
infra_repo         = "joheee/TicTacToeInfra"
infra_branch       = "main"
app_repo           = "joheee/TicTacToeCICD"
app_branch         = "main"
